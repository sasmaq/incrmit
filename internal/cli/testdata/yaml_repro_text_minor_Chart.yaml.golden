apiVersion: v2
name: webapp
description: A Helm chart for webapp 1.5.0 on Kubernetes
type: application
version: 0.8.0
appVersion: "1.5.0"
kubeVersion: ">=1.23.0"
dependencies:
  - name: postgresql
    version: 12.6.0
    repository: https://charts.bitnami.com/bitnami
  - name: redis
    version: "~17.12.0"
    repository: https://charts.bitnami.com/bitnami
annotations:
  artifacthub.io/images: |
    - name: webapp
      image: ghcr.io/example/webapp:1.5.0
