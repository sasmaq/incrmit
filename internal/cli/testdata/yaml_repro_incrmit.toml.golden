# incrmit.toml (generated by `incrmit discover`)

# ignore: folders and files for `incrmit discover` to skip, on top of the
# built-in ignores (.git, node_modules, vendor, and build outputs). Like
# each file's path, a pattern is relative to the folder this file is in.
# ignore = ["testdata/", "*.lock", "docs/**"]

[[files]]
  path = "Chart.yaml"
  version = "0.7.3"
  key = "version"

[[files]]
  path = "Chart.yaml"
  version = "1.4.2"
  key = "appVersion"

[[files]]
  path = "deploy.yaml"
  version = "1.4.2"
  parser = "text"

[[files]]
  path = "pubspec.yaml"
  version = "2.3.1"
  build = "45"
  key = "version"
